generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  fullName            String
  phone               String
  nationality         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bookings            Booking[]
  identifications     Identification[]
  karaokeReservations KaraokeReservation[]
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  fullName     String
  passwordHash String
  role         AdminRole @default(STAFF)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Room {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  type          RoomType
  tagline       String
  description   String
  pricePerNight Int
  capacity      Int
  surfaceSqm    Int
  imageUrl      String
  amenities     String[]
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  totalUnits    Int       @default(1)
  bookings      Booking[]

  @@index([type, isActive])
}

model Booking {
  id             String          @id @default(cuid())
  reference      String          @unique
  userId         String
  roomId         String
  checkIn        DateTime        @db.Date
  checkOut       DateTime        @db.Date
  nights         Int
  guests         Int
  subtotalXof    Int             @default(0)
  vatXof         Int             @default(0)
  cityTaxXof     Int             @default(0)
  totalXof       Int
  status         BookingStatus   @default(PENDING_PAYMENT)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  room           Room            @relation(fields: [roomId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  identification Identification?
  payment        Payment?

  @@index([userId])
  @@index([roomId, checkIn, checkOut])
  @@index([status])
}

model Identification {
  id           String    @id @default(cuid())
  bookingId    String    @unique
  userId       String
  fullName     String
  idType       IdType
  idNumber     String
  imageUrl     String
  imageKey     String?
  rgpdAccepted Boolean   @default(false)
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  imageBackKey String?
  imageBackUrl String?
  // Set when the in-chat ID verifier finds the declared data does not match the
  // scanned document (warn + manual staff review; the agent never auto-blocks).
  verificationNote String?
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  method        PaymentMethod @default(WAVE)
  amountXof     Int
  waveReference String?
  status        PaymentStatus @default(PENDING)
  submittedAt   DateTime?
  verifiedAt    DateTime?
  rejectedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ChatSession {
  id         String        @id @default(cuid())
  language   String?
  guestName  String?
  guestEmail String?
  guestPhone String?
  summary    String?
  status     ChatStatus    @default(OPEN)
  bookingRef String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  messages   ChatMessage[]

  @@index([status, createdAt])
  @@index([guestEmail])
}

model ChatMessage {
  id         String      @id @default(cuid())
  sessionId  String
  role       ChatRole
  content    String
  toolName   String?
  toolArgs   Json?
  toolResult Json?
  createdAt  DateTime    @default(now())
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model KaraokeReservation {
  id        String        @id @default(cuid())
  reference String        @unique
  userId    String?
  fullName  String
  phone     String
  email     String?
  date      DateTime      @db.Date
  partySize Int
  notes     String?
  status    KaraokeStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User?         @relation(fields: [userId], references: [id])

  @@index([date])
}

enum RoomType {
  VILLA
  ROOM
}

enum BookingStatus {
  PENDING_PAYMENT
  AWAITING_VERIFICATION
  CONFIRMED
  CANCELLED
}

enum IdType {
  CNI
  PASSPORT
  CONSULAR_CARD
  RESIDENCE_PERMIT
}

enum PaymentMethod {
  WAVE
  CASH_ON_ARRIVAL
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum KaraokeStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum AdminRole {
  STAFF
  MANAGER
}

enum ChatStatus {
  OPEN
  COMPLETED
  ABANDONED
}

enum ChatRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}
